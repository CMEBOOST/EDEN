# ── ตัวแปรสำหรับ docker-compose (คัดลอกเป็น .env แล้วแก้ค่า) ──
# compose อ่านไฟล์ .env ที่ root อัตโนมัติ ใช้แทนค่าที่ ${...} ใน docker-compose.yml
# ถ้าไม่มีไฟล์นี้ จะ fallback เป็น default ในวงเล็บ (พอสำหรับ dev)

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=EDEN_DB
POSTGRES_PORT=5433

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# พอร์ต host ของ app
BACKEND_PORT=8000
FRONTEND_PORT=5173

# base URL ที่ browser ใช้เรียก backend (ต้องเข้าถึงได้จากเครื่อง user)
# local/dev: http://localhost:8000 · deploy: โดเมน/IP จริงของ backend
VITE_API_BASE=http://localhost:8000

# หมายเหตุ: SECRET_KEY / ACCESS_TOKEN_EXPIRE_MINUTES อยู่ที่ backend-eden/.env
# (compose ฉีดเข้า service backend ผ่าน env_file)
