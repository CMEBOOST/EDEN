# ── ตัวแปรสำหรับ docker-compose.prod.yml ──
#   cp .env.prod.example .env   แล้วแก้ค่า (compose อ่านไฟล์ .env ที่ root อัตโนมัติ)

# Postgres — prod ต้องตั้ง POSTGRES_PASSWORD (ไม่มี default)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=EDEN_DB

# base URL ที่ browser ใช้เรียก backend — single-origin ผ่าน nginx proxy = /api
VITE_API_BASE=/api

# จำนวน uvicorn worker ของ backend
WEB_CONCURRENCY=2

# พอร์ต host ของ nginx (SPA + /api proxy)
HTTP_PORT=80

# หมายเหตุ: SECRET_KEY / FIELD_ENCRYPTION_KEY อยู่ที่ backend-eden/.env
#   prod ต้องใส่ค่าจริง (gen: python -c "import secrets;print(secrets.token_urlsafe(48))")
