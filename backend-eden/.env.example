# คัดลอกเป็น .env แล้วแก้ค่า
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# คีย์เข้ารหัสข้อมูล PII ในตาราง (เลขบัตร ปชช.) — Fernet key
# ไม่ตั้ง = อนุมานจาก SECRET_KEY (dev ใช้ได้เลย) · prod แนะนำให้ตั้งแยก
#   (ถ้าหมุน SECRET_KEY โดยไม่ตั้งค่านี้ ข้อมูลที่เข้ารหัสไว้เดิมจะอ่านไม่ออก)
# gen: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# ใช้ตอนรันใน Docker (local จะ default 127.0.0.1:5433 อยู่แล้ว)
# DATABASE_URL=postgresql://postgres:admin123@postgres:5432/EDEN_DB
